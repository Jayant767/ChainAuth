# Backend
SERVER_PORT=8080
MONGODB_URI=mongodb://localhost:27017/chainauth
FRONTEND_ORIGIN=http://localhost:5173
ETHEREUM_RPC_URL=http://127.0.0.1:8545
ETHEREUM_CHAIN_ID=31337

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Phase 2 authentication (use a unique random secret in production)
JWT_SECRET=replace-with-at-least-32-random-bytes-before-deployment
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=7
SECURE_COOKIE=false

# SIWE wallet authentication
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
SIWE_NONCE_TTL_SECONDS=300

# Phase 4 — IdentityRegistry contract (fill after local deployment)
IDENTITY_REGISTRY_ADDRESS=
# Backend transaction signer. Development only; never commit a real private key.
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
BLOCKCHAIN_GAS_LIMIT=600000
# Public address corresponding to the backend signer (deployment script grants manager role)
CHAINAUTH_BACKEND_SIGNER_ADDRESS=

# Phase 5 durable blockchain synchronization
BLOCKCHAIN_CONFIRMATIONS=3
BLOCKCHAIN_MAX_SYNC_ATTEMPTS=5
BLOCKCHAIN_SYNC_POLL_MS=5000

BLOCKCHAIN_EVENT_START_BLOCK=0
BLOCKCHAIN_EVENT_POLL_MS=15000
BLOCKCHAIN_TRANSACTION_TIMEOUT_SECONDS=600

# Phase 6 security controls
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUDIT_HASH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
